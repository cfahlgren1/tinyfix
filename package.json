{
  "name": "tinyfix",
  "version": "0.1.1",
  "description": "Autocorrect that reads both sides of a word. A 2 MB model that runs in the browser and fixes “form” when you meant “from”.",
  "keywords": [
    "autocorrect",
    "browser",
    "offline",
    "onnx",
    "spellcheck",
    "spelling",
    "typo"
  ],
  "homepage": "https://github.com/cfahlgren1/tinyfix#readme",
  "license": "MIT",
  "author": "Caleb Fahlgren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfahlgren1/tinyfix.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "models": "node scripts/download-models.mjs",
    "test": "npm run models && tsx --test test/*.test.ts",
    "prepublishOnly": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tsx": "^4.19.0",
    "typescript": "~5.9"
  },
  "engines": {
    "node": ">=18"
  }
}
